{
  "expo": {
    "name": "PromptVaults",
    "slug": "PromptVaults",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "promptvaults",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ntp.PromptVaults",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ntp.PromptVaults",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép PromptVault dùng Face ID để mở khoá app."
        }
      ],
      [
        "@sbaiahmed1/react-native-biometrics",
        {
          "faceIDPermission": "Cho phép PromptVault dùng Face ID để đăng nhập."
        }
      ],
      "expo-background-task",
      "@react-native-google-signin/google-signin",
      [
        "react-native-fbsdk-next",
        {
          "appID": "28617340301240026",
          "clientToken": "2f069e278967798bb894218a4f34b1d8",
          "displayName": "PromptVaults",
          "scheme": "fb28617340301240026"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ccbec8e0-eefe-4684-aee8-104a25af4a96"
      }
    },
    "owner": "ntp"
  }
}
